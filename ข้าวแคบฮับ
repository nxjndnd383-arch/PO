-- ===== AutoCollect =====
local AC_ENABLED = false
local SCAN_TICK, MAX_DISTANCE, MAX_PER_PASS, PASSES_PER_TICK, PROMPT_COOLDOWN = 0.03, 100, 50, 3, 0.15
local lastScan = 0
local promptCooldown, cachedPrompts, farm = {}, {}, nil

local function getMyFarm()
    if farm and farm.Parent then return farm end
    local f = Workspace:FindFirstChild("Farm")
    if not f then return end
    for _, fm in ipairs(f:GetChildren()) do
        if fm:GetAttribute("OwnerId") == LocalPlayer.UserId then
            farm = fm
            return fm
        end
    end
end

local function getPos()
    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    return h and h.Position
end

local function firePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local now = os.clock()
    local last = promptCooldown[prompt]
    if last and (now - last) < PROMPT_COOLDOWN then return false end
    promptCooldown[prompt] = now
    pcall(function()
        local orig = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
        prompt.HoldDuration = orig
    end)
    return true
end

local function addPrompt(prompt)
    local part = prompt.Parent
    if part and part:IsA("BasePart") then
        table.insert(cachedPrompts, { prompt = prompt, part = part })
    end
end

local function rebuildCache()
    cachedPrompts = {}
    local f = getMyFarm()
    if not f then return end
    for _, obj in ipairs(f:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "ProductPrompt" then
            addPrompt(obj)
        end
    end
end

local function onePass(pos)
    local count = 0
    for i = 1, #cachedPrompts do
        local e = cachedPrompts[i]
        local prompt, part = e.prompt, e.part
        if prompt.Parent and prompt.Enabled and part.Parent then
            local dx, dy, dz = part.Position.X - pos.X, part.Position.Y - pos.Y, part.Position.Z - pos.Z
            if (dx*dx + dy*dy + dz*dz) <= MAX_DISTANCE * MAX_DISTANCE and firePrompt(prompt) then
                count = count + 1
                if count >= MAX_PER_PASS then break end
            end
        end
    end
    return count
end

local function burstScan()
    if not AC_ENABLED then return end
    local pos = getPos()
    if not pos then return end
    for _ = 1, PASSES_PER_TICK do
        if onePass(pos) == 0 then break end
    end
    local now = os.clock()
    for p, t in pairs(promptCooldown) do
        if not p.Parent or (now - t) > 5 then promptCooldown[p] = nil end
    end
end

local function hookFarm()
    local f = getMyFarm()
    if not f then return end
    f.DescendantAdded:Connect(function(obj)
        if obj:IsA("ProximityPrompt") and obj.Name == "ProductPrompt" then addPrompt(obj) end
    end)
    f.DescendantRemoving:Connect(function(obj)
        if obj:IsA("ProximityPrompt") then
            for i = #cachedPrompts, 1, -1 do
                if cachedPrompts[i].prompt == obj then table.remove(cachedPrompts, i) end
            end
        end
    end)
end

task.spawn(function()
    while not getMyFarm() do task.wait(1) end
    rebuildCache()
    hookFarm()
end)

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastScan < SCAN_TICK then return end
    lastScan = now
    burstScan()
end)

-- ===== AutoClaim =====
local AP_ENABLED = false
local CLAIM_INTERVAL = 0.8
local lastClaim = 0
local RequestClaimProduction, FactoryConfig, FactoryCfg

local function safeRequire(parent, name)
    local mod = parent and parent:FindFirstChild(name)
    if not mod then return nil end
    local ok, result = pcall(function() return require(mod) end)
    if ok then return result end
end

task.spawn(function()
    local tries = 0
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    while not Remotes and tries < 30 do
        task.wait(1)
        Remotes = ReplicatedStorage:FindFirstChild("Remotes")
        tries = tries + 1
    end
    if not Remotes then return end

    tries = 0
    RequestClaimProduction = Remotes:FindFirstChild("RequestClaimProduction")
    while not RequestClaimProduction and tries < 20 do
        task.wait(0.5)
        RequestClaimProduction = Remotes:FindFirstChild("RequestClaimProduction")
        tries = tries + 1
    end
    if not RequestClaimProduction then return end

    local Modules = ReplicatedStorage:WaitForChild("Modules", 20)
    FactoryConfig = safeRequire(Modules, "FactoryConfig")
    FactoryCfg = FactoryConfig and FactoryConfig.Config
end)

local function safeJsonDecode(str, default)
    if type(str) ~= "string" or str == "" then return default or {} end
    local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
    if ok and type(data) == "table" then return data end
    return default or {}
end

local function getQueueJSON()
    return safeJsonDecode(LocalPlayer:GetAttribute("FactoryQueue_JSON"), {})
end

local function getUnlockedFactories()
    return safeJsonDecode(LocalPlayer:GetAttribute("UnlockedFactories_JSON"), {})
end

local function hasReadyToClaim(factoryName)
    local data = getQueueJSON()[factoryName]
    if not data then return false end
    local now = Workspace:GetServerTimeNow()
    local list = data.Q or data

    for _, item in ipairs(list) do
        if type(item) == "table" and now >= (item.EndTime or 0) then
            return true
        end
    end
    if data.R then
        if type(data.R) == "table" then
            for _, v in pairs(data.R) do
                if tonumber(v) and tonumber(v) > 0 then return true end
            end
        elseif tonumber(data.R) and tonumber(data.R) > 0 then
            return true
        end
    end
    if data.B then
        for _, v in pairs(data.B) do
            if tonumber(v) and tonumber(v) > 0 then return true end
        end
    end
    return false
end

local function autoClaim()
    if not AP_ENABLED or not RequestClaimProduction or not FactoryCfg then return end
    if os.clock() - lastClaim < CLAIM_INTERVAL then return end
    lastClaim = os.clock()

    local unlocked = getUnlockedFactories()
    for factoryName in pairs(unlocked) do
        if FactoryCfg[factoryName] and hasReadyToClaim(factoryName) then
            pcall(function()
                RequestClaimProduction:InvokeServer(factoryName)
            end)
            task.wait(0.3)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(autoClaim)
    end
end)

-- ===== AutoSell (จากโค้ดที่ให้มา) =====
local AS_ENABLED = false
local SELL_INTERVAL = 2
local RequestSendDelivery

task.spawn(function()
    local tries = 0
    RequestSendDelivery = ReplicatedStorage:FindFirstChild("RequestSendDelivery")
    while not RequestSendDelivery and tries < 20 do
        task.wait(0.5)
        RequestSendDelivery = ReplicatedStorage:FindFirstChild("RequestSendDelivery")
        tries = tries + 1
    end
end)

task.spawn(function()
    while true do
        task.wait(SELL_INTERVAL)

        if not AS_ENABLED then continue end
        if not RequestSendDelivery then continue end

        if LocalPlayer:GetAttribute("DataLoadedSuccessfully") ~= true then
            continue
        end
        if LocalPlayer:GetAttribute("IsDelivering") == true then
            continue
        end

        local invJSON = LocalPlayer:GetAttribute("Inventory_JSON") or "{}"
        local ok, inv = pcall(HttpService.JSONDecode, HttpService, invJSON)
        if not ok or type(inv) ~= "table" then
            continue
        end

        local cart = {}
        local hasItem = false
        for name, count in pairs(inv) do
            local c = tonumber(count) or 0
            if c > 0 then
                cart[name] = c
                hasItem = true
            end
        end
        if not hasItem then
            continue
        end

        local success, result = pcall(function()
            return RequestSendDelivery:InvokeServer(cart)
        end)
        if success and result then
            print("[AutoSell] ส่งสำเร็จ")
        else
            warn("[AutoSell] ส่งไม่สำเร็จ:", result)
        end
    end
end)

